# agent-relay configuration
# Copy to .env and adjust. All settings have defaults; none are required.

# Listen address
PORT=8787
HOST=0.0.0.0

# SQLite file (created automatically). Directory is created if missing.
DB_PATH=./data/relay.db

# Boxes whose last write is older than this many days are treated as expired
# (410 gone_expired) and hard-deleted by the hourly sweeper.
RETENTION_DAYS=30

# Max messages stored in a single box. Further writes return 409 box_full.
MAX_BOX_MESSAGES=10000

# Per-key rate limits
RATE_LIMIT_WRITES_PER_MIN=60
RATE_LIMIT_READS_PER_MIN=300

# Per-IP box creation
RATE_LIMIT_CREATE_PER_IP_PER_DAY=20

# Per-IP floors so omitting Authorization cannot bypass limits
RATE_LIMIT_IP_WRITES_PER_MIN=120
RATE_LIMIT_IP_READS_PER_MIN=600

# Sweeper period (milliseconds). Default is 1 hour.
SWEEP_INTERVAL_MS=3600000

# Fastify log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
